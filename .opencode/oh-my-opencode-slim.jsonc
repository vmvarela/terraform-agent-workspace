// oh-my-opencode-slim — FULL config for the prisamedia workspace.
//
// Source snapshot: ~/.config/opencode/oh-my-opencode-slim.json (dotfiles).
// Precedence: project config (.opencode/) overrides user config, so anything
// defined here wins inside this repo. Keep it in sync with your dotfiles by
// hand — changes to the dotfiles copy do NOT apply here automatically.
//
// Preset renamed to "default" on purpose: it is the default preset of this
// workspace, and pinning it here blocks preset switching from the TUI while
// you are inside this repo (expected behaviour, not a bug).
//
// No repo-specific agents (see AGENTS.md section 6 for routing).
//
// Apply: restart OpenCode.

{
  "preset": "default",

  "presets": {
    "default": {
      "orchestrator": {
        "model": "openai/gpt-6-luna",
        "variant": "high"
      },
      "oracle": {
        "model": "openai/gpt-6-sol",
        "variant": "high"
      },
      "council": {
        "model": [
          "opencode/muse-spark-1.3-contributor-free",
          "opencode/mimo-v2.6-flash-free",
          "opencode/nemotron-3-ultra-free"
        ],
        "variant": "medium"
      },
      "librarian": {
        "model": "opencode-go/deepseek-v4.1-flash",
        "variant": "low"
      },
      "explorer": {
        "model": "opencode-go/deepseek-v4.1-flash",
        "variant": "low",
        "mcps": ["atlassian"]
      },
      "designer": {
        "model": "github-copilot/gemini-3.8-flash",
        "mcps": ["playwright"]
      },
      "fixer": {
        "model": "opencode-go/glm-5.3-flash",
        "variant": "high"
      },
      "observer": {
        "model": "opencode-go/qwen3.8-flash"
      }
    }
  },

  "disabled_agents": [],

  "todoContinuation": {
    "maxContinuations": 15,
    "cooldownMs": 3000,
    "autoEnable": false,
    "autoEnableThreshold": 4
  }
}
