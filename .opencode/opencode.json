{
  "$schema": "https://opencode.ai/config.json",
  "plugins": [
    {
      "package": "opencode-model-aliases@latest",
      "options": {
        "debug": true,
        "aliases": {
          "openai/gpt-luna": {
            "match": "openai/gpt-*-luna",
            "name": "GPT Luna (latest)",
            "select": { "strategy": "latest" }
          },
          "openai/gpt-sol": {
            "match": "openai/gpt-*-sol",
            "name": "GPT Sol (latest)",
            "select": { "strategy": "latest" }
          },
          "opencode-go/deepseek-flash": {
            "match": "opencode-go/deepseek-*-flash",
            "name": "DeepSeek Flash (latest)",
            "select": { "strategy": "latest" }
          },
          "github-copilot/gemini-flash": {
            "match": "github-copilot/gemini-*-flash",
            "name": "Gemini Flash (latest)",
            "select": { "strategy": "latest" }
          },
          "opencode-go/glm-flash": {
            "match": "opencode-go/glm-*-flash",
            "name": "GLM Flash (latest)",
            "select": { "strategy": "latest" }
          },
          "opencode-go/qwen-flash": {
            "match": "opencode-go/qwen*-flash",
            "name": "Qweb Flash (latest)",
            "select": { "strategy": "latest" }
          }
        }
      }
    },
    "oh-my-opencode-slim@latest",
    "@slkiser/opencode-quota@latest"
  ],
  "default_agent": "plan",
  "share": "disabled",
  "permissions": [
    { "action": "edit", "resource": "*", "effect": "ask" },
    { "action": "shell", "resource": "*", "effect": "ask" },
    { "action": "shell", "resource": "git status *", "effect": "allow" },
    { "action": "shell", "resource": "terraform apply*", "effect": "ask" },
    { "action": "shell", "resource": "terraform destroy*", "effect": "deny" },
    { "action": "shell", "resource": "helm upgrade*", "effect": "ask" },
    { "action": "shell", "resource": "helm uninstall*", "effect": "ask" },
    { "action": "shell", "resource": "kubectl apply*", "effect": "ask" },
    { "action": "shell", "resource": "kubectl delete*", "effect": "ask" },
    { "action": "shell", "resource": "git push*", "effect": "ask" },
    { "action": "shell", "resource": "gh pr merge*", "effect": "ask" },
    { "action": "shell", "resource": "gh repo delete*", "effect": "deny" },
    { "action": "github_*", "resource": "*", "effect": "deny" },
    { "action": "github_get_*", "resource": "*", "effect": "allow" },
    { "action": "github_list_*", "resource": "*", "effect": "allow" },
    { "action": "github_search_*", "resource": "*", "effect": "allow" },
    { "action": "kubernetes_kubectl_apply*", "resource": "*", "effect": "deny" },
    { "action": "kubernetes_kubectl_delete*", "resource": "*", "effect": "deny" },
    { "action": "atlassian_*", "resource": "*", "effect": "ask" }
  ],
  "agents": {
    "explore": {
      "disabled": true
    },
    "general": {
      "disabled": true
    },
    "plan": {
      "model": "opencode/mimo-v2.6-flash-free#high"
    },
    "build": {
      "model": "opencode/mimo-v2.6-flash-free"
    },
    "title": {
      "model": "opencode/space-bunny-free"
    }
  },
  "mcp": {
    "servers": {
      "playwright": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@playwright/mcp@latest",
          "--caps=core,network,vision"
        ]
      },
      "atlassian": {
        "type": "remote",
        "url": "https://mcp.atlassian.com/v2/mcp"
      }
    }
  },
  "providers": {
    "copilot": {},
    "openai": {},
    "opencode-go": {},
    "opencode": {}
  }
}
